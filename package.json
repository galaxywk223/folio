{
  "name": "folio",
  "version": "1.0.4",
    "private": false,
  "description": "Folio — local desk for tasks and subscriptions",
  "author": "Wang Kai",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "homepage": "https://github.com/galaxywk223/folio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxywk223/folio.git"
  },
  "bugs": {
    "url": "https://github.com/galaxywk223/folio/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test scripts/subscriptions.test.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:publish": "npm run build && electron-builder --win nsis --x64 --publish always",
    "icon": "node scripts/generate-icon.mjs",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.galaxywk.folio",
    "productName": "Folio",
    "artifactName": "Folio-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "galaxywk223",
        "repo": "folio"
      }
    ]
  }
}
